<UserControl x:Class="EmailCompleteApp.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- colors + styles (unchanged) -->
        <SolidColorBrush x:Key="BackgroundColor" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#007BFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#212529"/>
        <SolidColorBrush x:Key="SendEmailHover" Color="#20C997"/>
        <SolidColorBrush x:Key="BorderColor" Color="Black"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#007BFF"/>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextColor}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource PrimaryColor}"/>
        </Style>
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <!-- Converter for visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Istoric"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextColor}"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>

        <!-- Header -->
        <Grid Grid.Row="1"
              Background="#FFEFEFEF"
              Height="Auto"
              TextBlock.TextAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="c0" MinWidth="80" MaxWidth="100"/>
                <ColumnDefinition SharedSizeGroup="c1" MinWidth="150" MaxWidth="200"/>
                <ColumnDefinition SharedSizeGroup="c2" MinWidth="100" MaxWidth="150"/>
                <ColumnDefinition SharedSizeGroup="c3" MinWidth="100" MaxWidth="150"/>
                <ColumnDefinition SharedSizeGroup="c4" MinWidth="100" MaxWidth="150"/>
                <ColumnDefinition SharedSizeGroup="c5" MinWidth="100" MaxWidth="150"/>
                <ColumnDefinition SharedSizeGroup="c6" MinWidth="100" MaxWidth="150"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Nr. Comanda" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Ruta" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Incarcare" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Desarcare" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Tarif client" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="Tarif transportator" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="Data" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2">
            <ListBox
                 x:Name="HistoryListBox"
                 SelectionChanged="HistoryListBox_SelectionChanged"
                 ItemsSource="{Binding HistoryData}"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 BorderThickness="0"
                 Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="c0" MinWidth="80" MaxWidth="100"/>
                                <ColumnDefinition SharedSizeGroup="c1" MinWidth="150" MaxWidth="200"/>
                                <ColumnDefinition SharedSizeGroup="c2" MinWidth="100" MaxWidth="150"/>
                                <ColumnDefinition SharedSizeGroup="c3" MinWidth="100" MaxWidth="150"/>
                                <ColumnDefinition SharedSizeGroup="c4" MinWidth="100" MaxWidth="150"/>
                                <ColumnDefinition SharedSizeGroup="c5" MinWidth="100" MaxWidth="150"/>
                                <ColumnDefinition SharedSizeGroup="c6" MinWidth="100" MaxWidth="150"/>
                            </Grid.ColumnDefinitions>

                            <!-- Match headers (HisotryTransport model propertiEs) -->
                            <TextBlock Grid.Column="0" Text="{Binding NumarComanda}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Route}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding DisplayDateLoaded}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding DisplayDateUnloaded}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding ClientTarif}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding TransportatorTarif}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="{Binding DisplayDateCreatedAt}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Loading -->
            <Border Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                    <TextBlock Text="Se incarca..." Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
