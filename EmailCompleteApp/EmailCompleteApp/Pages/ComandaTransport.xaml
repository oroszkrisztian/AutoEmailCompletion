<UserControl x:Class="EmailCompleteApp.Pages.ComandaTransport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Light theme color scheme -->
        <SolidColorBrush x:Key="BackgroundColor" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#007BFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#212529"/>
        <SolidColorBrush x:Key="SendEmailHover" Color="#20C997"/>
        <SolidColorBrush x:Key="BorderColor" Color="Black"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#007BFF"/>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextColor}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource PrimaryColor}"/>
        </Style>
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Comanda Transport"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,40,0"
                       Foreground="{StaticResource TextColor}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Button Content="Send Email"
                    Background="{StaticResource PrimaryColor}"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="16,8"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnSendClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SendEmailHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Inputs -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="900" Margin="40,40,40,0" VerticalAlignment="Top">
                <TextBlock Text="Numar Comanda:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                <TextBox x:Name="NumarComandaTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                <!-- Row 1 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Client:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ClientComboBox" 
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  IsEditable="True" 
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  TextBoxBase.TextChanged="OnClientTextChanged"
                                  SelectionChanged="OnClientSelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Tarif:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TarifTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Primit:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PrimitTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Moneda:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="MonedaComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="EUR"/>
                            <ComboBoxItem Content="RON"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Tip:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TipComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="TVA"/>
                            <ComboBoxItem Content="ALL IN"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Row 2 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Transportator:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TransportatorComboBox" 
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  IsEditable="True" 
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  TextBoxBase.TextChanged="OnTransportatorTextChanged"
                                  SelectionChanged="OnTransportatorSelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Tarif:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TransportatorTarifTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Oferit:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox x:Name="OferitTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Moneda:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TransportatorMonedaComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="EUR"/>
                            <ComboBoxItem Content="RON"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Tip:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TransportatorTipComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="TVA"/>
                            <ComboBoxItem Content="ALL IN"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Row 3 (Dates) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Data de incarcare:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DataIncarcareDatePicker" FontSize="18" Height="46"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Data de descarcare:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DataDescarcareDatePicker" FontSize="18" Height="46"/>
                    </StackPanel>
                </Grid>

                <!-- Row 4 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Produs:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ProdusTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Cantitate:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox x:Name="CantitateTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Tip:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TipAdrComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="ADR"/>
                            <ComboBoxItem Content="NON-ADR"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Clasa:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClasaTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="UM:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox x:Name="UMTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Numar Inmatriculare -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Numar Inmatriculare:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                    <TextBox x:Name="NumarInmatriculareTextBox" Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>

                <!-- Locatii -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Adresa incarcare:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="LocatieIncarcareComboBox" 
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  IsEditable="True" 
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  TextBoxBase.TextChanged="OnIncarcareTextChanged"
                                  SelectionChanged="OnIncarcareSelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Adresa descarcare:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="LocatieDescarcareComboBox" 
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  IsEditable="True" 
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  TextBoxBase.TextChanged="OnDescarcareTextChanged"
                                  SelectionChanged="OnDescarcareSelectionChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Max Days -->
                <TextBlock Text="Termen de plata:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                <TextBox x:Name="MaxDaysTextBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>