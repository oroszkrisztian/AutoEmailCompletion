<UserControl x:Class="EmailCompleteApp.Pages.ComandaTransport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:converters="clr-namespace:EmailCompleteApp.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <!-- Light theme color scheme -->
        <SolidColorBrush x:Key="BackgroundColor" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#007BFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#212529"/>
        <SolidColorBrush x:Key="SendEmailHover" Color="#20C997"/>
        <SolidColorBrush x:Key="BorderColor" Color="Black"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#007BFF"/>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextColor}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource PrimaryColor}"/>
        </Style>
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AutoCompleteComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Title - shows (Edit) when in edit mode -->
            <StackPanel Grid.Column="0" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock Text="Comanda Transport"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="{StaticResource TextColor}"/>
                <TextBlock Text=" (Edit)"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="{StaticResource TextColor}"
                          Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}"/>
            </StackPanel>
            
            <!-- Button Container - shows different buttons based on mode -->
            <StackPanel Grid.Column="1" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                
                <!-- Send Email Button - only visible when form is visible AND NOT in edit mode -->
                <Button Content="Send Email"
                        Background="{StaticResource PrimaryColor}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="16,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Visibility="{Binding ShowSendEmailButton, Converter={StaticResource BoolToVisConverter}}"
                        Command="{Binding SendEmailCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SendEmailHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                
                <!-- Update Button - only visible in edit mode -->
                <Button Content="Actualizează"
                        Background="{StaticResource PrimaryColor}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="16,8"
                        Margin="0,0,10,0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}"
                        Command="{Binding UpdateOrderCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SendEmailHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                
                <!-- Cancel Button - only visible in edit mode -->
                <Button Content="Anulează"
                        Background="#6C757D"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="16,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}"
                        Command="{Binding CancelEditCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#5A6268"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Inputs -->
        <ScrollViewer Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVisConverter}}" 
                      Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="900" Margin="40,40,40,0" VerticalAlignment="Top">
                
                <!--Row 0-->
                <Grid Margin="0,0,0,16" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Numar Comanda TankSped:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NumarComanda, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Numar client:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NumarClient, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>
                    </StackPanel>
                    
                    <!-- Ultima Comanda field and button - only visible when NOT in edit mode -->
                    <StackPanel Grid.Column="4" Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text="Ultima Comanda:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox IsEnabled="False" Text="{Binding LastOrderString, UpdateSourceTrigger=PropertyChanged }" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisConverter}}">
                        <Button Content="Ultima comanda"
                            Background="{StaticResource PrimaryColor}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="16,8"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding ReloadLastOrderCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">                
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SendEmailHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    
                </Grid>

                <!-- Row 1 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Client:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ClientComboBox"
                                  Text="{Binding Client, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ItemsSource="{Binding ClientSuggestions}"
                                  Style="{StaticResource AutoCompleteComboBoxStyle}"
                                  DropDownOpened="ComboBox_DropDownOpened"
                                  PreviewKeyDown="ComboBox_PreviewKeyDown"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  GotFocus="ComboBox_GotFocus"
                                  Loaded="ComboBox_Loaded"
                                  Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Tarif:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Tarif, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Moneda:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding MonedaIndex}" Style="{StaticResource ModernComboBoxStyle}">
                            <ComboBoxItem Content="EUR"/>
                            <ComboBoxItem Content="EUR/MT"/>
                            <ComboBoxItem Content="RON"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Tip:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding TipIndex}" Style="{StaticResource ModernComboBoxStyle}">
                            <ComboBoxItem Content="TVA"/>
                            <ComboBoxItem Content="ALL IN"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Row 2 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Transportator:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TransportatorComboBox"
                                  Text="{Binding Transportator, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ItemsSource="{Binding TransportatorSuggestions}"
                                  Style="{StaticResource AutoCompleteComboBoxStyle}"
                                  DropDownOpened="ComboBox_DropDownOpened"
                                  PreviewKeyDown="ComboBox_PreviewKeyDown"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  GotFocus="ComboBox_GotFocus"
                                  Loaded="ComboBox_Loaded"
                                  Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Tarif:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TransportatorTarif, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Moneda:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding TransportatorMonedaIndex}" Style="{StaticResource ModernComboBoxStyle}">
                            <ComboBoxItem Content="EUR"/>
                            <ComboBoxItem Content="EUR/MT"/>
                            <ComboBoxItem Content="RON"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Tip:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding TransportatorTipIndex}" Style="{StaticResource ModernComboBoxStyle}">
                            <ComboBoxItem Content="TVA"/>
                            <ComboBoxItem Content="ALL IN"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Row 3 (Dates) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Data de incarcare:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DataIncarcare}" FontSize="18" Height="46" SelectedDateFormat="Short" Language="en-GB"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Data de descarcare:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DataDescarcare}" FontSize="18" Height="46" SelectedDateFormat="Short" Language="en-GB"/>
                    </StackPanel>
                </Grid>

                <!-- Row 4 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Produs:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ProdusComboBox"
                                  Text="{Binding Produs, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ItemsSource="{Binding ProductSuggestions}"
                                  Style="{StaticResource AutoCompleteComboBoxStyle}"
                                  DropDownOpened="ComboBox_DropDownOpened"
                                  PreviewKeyDown="ComboBox_PreviewKeyDown"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  GotFocus="ComboBox_GotFocus"
                                  Loaded="ComboBox_Loaded"
                                  Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Cantitate (kg):" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Cantitate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Tip:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding TipAdrIndex}" Style="{StaticResource ModernComboBoxStyle}">
                            <ComboBoxItem Content="ADR"/>
                            <ComboBoxItem Content="NON-ADR"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Clasa:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Clasa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="UN:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Un, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Contact Row -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Contact:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ContactComboBox"
                              Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              ItemsSource="{Binding ContactSuggestions}"
                              Style="{StaticResource AutoCompleteComboBoxStyle}"
                              DropDownOpened="ComboBox_DropDownOpened"
                              PreviewKeyDown="ComboBox_PreviewKeyDown"
                              SelectionChanged="ComboBox_SelectionChanged"
                              GotFocus="ComboBox_GotFocus"
                              Loaded="ComboBox_Loaded"
                              Margin="0,0,0,8" />
                </StackPanel>

                <!-- Numar Inmatriculare -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Numar Inmatriculare:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NumarInmatriculare, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>

                <!-- Locatii -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Adresa incarcare:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="IncarcareComboBox"
                                  Text="{Binding LocatieIncarcare, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ItemsSource="{Binding IncarcareSuggestions}"
                                  Style="{StaticResource AutoCompleteComboBoxStyle}"
                                  DropDownOpened="ComboBox_DropDownOpened"
                                  PreviewKeyDown="ComboBox_PreviewKeyDown"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  GotFocus="ComboBox_GotFocus"
                                  Loaded="ComboBox_Loaded"
                                  Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Adresa descarcare:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DescarcareComboBox"
                                  Text="{Binding LocatieDescarcare, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ItemsSource="{Binding DescarcareSuggestions}"                                  
                                  Style="{StaticResource AutoCompleteComboBoxStyle}"
                                  DropDownOpened="ComboBox_DropDownOpened"
                                  PreviewKeyDown="ComboBox_PreviewKeyDown"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  GotFocus="ComboBox_GotFocus"
                                  Loaded="ComboBox_Loaded"
                                  Margin="0,0,0,8" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,100">
                    <TextBlock 
                        Text="Mentiuni:" 
                        FontSize="14" 
                        FontWeight="SemiBold" 
                        TextWrapping="Wrap" 
                        VerticalAlignment="Top" 
                        Foreground="{StaticResource TextColor}" 
                        Margin="0,0,0,4"/>

                    <TextBox 
                        Text="{Binding CommentUser, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource ModernTextBoxStyle}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Disabled"
                        TextChanged="CommentTextBox_TextChanged"
                        MinHeight="80"/>
                </StackPanel>
                
              
                
            </StackPanel>
        </ScrollViewer>

        <!-- Alternative UI - shown when IsFormVisible is false -->
        <Grid Grid.Row="1" 
              Visibility="{Binding IsFormVisible, Converter={StaticResource InverseBoolToVisConverter}}">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        MaxWidth="500">

                <Button Content="Comanda Noua"
                        Background="{StaticResource PrimaryColor}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="24,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        Command="{Binding NewOrderCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SendEmailHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>