<Window x:Class="EmailCompleteApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmailCompleteApp"
        mc:Ignorable="d"
        Title="Email Completion App"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="720" Width="1280"
        WindowState="Maximized">

    <Viewbox Stretch="UniformToFill">
        <Grid Background="#272537" x:Name="MainGrid" Width="1280" Height="720">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0"
                    Background="#1E1E2F">
                <StackPanel>
                    <Button x:Name="ClientButtonPage"
                            Content="Client/Transportator"
                            Margin="10"
                            Background="White"
                            Foreground="#272537"
                            Click="ClientButton_Click"
                            MouseEnter="ClientButton_MouseEnter"
                            MouseLeave="ClientButton_MouseLeave">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="LocationButtonPage"
                            Content="Locatii"
                            Margin="10"
                            Background="White"
                            Foreground="#272537"
                            Click="LocationButton_Click"
                            MouseEnter="LocationButton_MouseEnter"
                            MouseLeave="LocationButton_MouseLeave">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="ComandaTransportButton"
                            Content="Comanda Transport"
                            Margin="10"
                            Background="White"
                            Foreground="#272537"
                            Click="ComandaTransport_Click"
                            MouseEnter="ComandaTransportButton_MouseEnter"
                            MouseLeave="ComandaTransport_MouseLeave">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="ComandaTransportIstoricButton"
                            Content="Istoric"
                            Margin="10"
                            Visibility="Visible"
                            Background="White"
                            Foreground="#272537"
                            Click="ComandaTransportIstorict_Click"
                            MouseEnter="ComandaTransportIstorictButton_MouseEnter"
                            MouseLeave="ComandaTransportIstoric_MouseLeave">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>             
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!--Main Content Area-->
            <Border Grid.Column="1"
                    Background="White">
                <ContentControl x:Name="MainContentArea">
                    <Grid>
                        <TextBlock Text="Chose email to complete from sidebar!"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#272537"/>
                    </Grid>
                </ContentControl>
            </Border>
        </Grid>
    </Viewbox>
</Window>